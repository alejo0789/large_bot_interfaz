# TikTok Business Messaging account authorization
TIKTOK_APP_ID=your_tiktok_app_id
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_ACCOUNT_AUTHORIZATION_URL=paste_the_authorization_url_from_tiktok_my_apps
TIKTOK_REDIRECT_URI=https://your-backend-domain/api/tiktok/oauth/callback
TIKTOK_WEBHOOK_CALLBACK_URL=https://your-backend-domain/webhook/tiktok
# Generate a random 32-byte key and encode it as Base64 or 64 hexadecimal characters.
TIKTOK_TOKEN_ENCRYPTION_KEY=your_random_32_byte_base64_or_64_char_hex_key
